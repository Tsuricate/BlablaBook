{
  "name": "back",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx --watch --env-file=.env ./src/index.ts",
    "docker:dev": "pnpm prisma:generate && pnpm prisma:push && pnpm dev",
    "prisma:generate": "dotenv -e .env prisma generate",
    "prisma:push": "dotenv -e .env prisma db push",
    "prisma:migrate:dev": "dotenv -e .env prisma migrate dev",
    "prisma:migrate:deploy": "dotenv -e .env prisma migrate deploy",
    "prisma:migrate:reset": "dotenv -e .env prisma migrate reset --force",
    "prisma:migrate:prod": "dotenvx run -f ../.env.docker.prod -- prisma migrate deploy",
    "prisma:seed": "tsx ./src/models/library-seeding.ts",
    "prisma:reset": "pnpm prisma:migrate:reset && pnpm prisma:seed",
    "db:pull:dev": "dotenv -e .env -- prisma db pull",
    "db:pull:test": "dotenv -e .env.test -- prisma db pull",
    "start": "tsx ./src/index.ts",
    "seed": "tsx prisma/seed.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:wait": "until pg_isready -h localhost -p 5435 -U postgres; do sleep 1; done",
    "test:db:migrate": "dotenv -e .env.test -- tsx ./node_modules/prisma/build/index.js migrate reset --force --skip-seed",
    "test:run": "vitest run",
    "test:integration": "pnpm test:db:up && pnpm test:db:wait && pnpm test:db:migrate && dotenv -e .env.test -- vitest run",
    "test:integration:ci": "pnpm test:db:up && pnpm test:db:wait && pnpm prisma:generate && pnpm test:db:migrate && pnpm test:run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.1",
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@types/ms": "^2.1.0",
    "argon2": "^0.44.0",
    "axios": "^1.13.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-xss-sanitizer": "^2.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.69.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/express-xss-sanitizer": "^2.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.2",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
